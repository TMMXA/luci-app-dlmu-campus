#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NAME=dlmu-campus-login
PROG=/usr/bin/dlmu-campus-login
EXTRA_COMMANDS="login probe portal_logout"
EXTRA_HELP="	login		Run one immediate login/check
	probe		Run one read-only connectivity probe
	portal_logout	Log out from the campus portal"

start_service() {
	config_load dlmu_campus
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || {
		echo "$NAME 已在 /etc/config/dlmu_campus 中禁用"
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG" --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}

login() {
	"$PROG" --once
}

probe() {
	"$PROG" --probe
}

portal_logout() {
	"$PROG" --portal-logout
}

status() {
	if pgrep -f "$PROG --daemon" >/dev/null 2>&1; then
		echo "运行中"
	else
		echo "已停止"
	fi
	"$PROG" --status-text 2>/dev/null || true
}
