#!/usr/bin/env python3
import argparse
import base64
import json
import os
import re
import signal
import subprocess
import sys
import time
from datetime import datetime
from urllib.parse import urljoin, urlparse, parse_qs

import requests
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad
from urllib3.exceptions import InsecureRequestWarning

requests.packages.urllib3.disable_warnings(category=InsecureRequestWarning)

CONFIG = "dlmu_campus"
STATUS_DIR = "/var/run/dlmu-campus-login"
STATUS_FILE = f"{STATUS_DIR}/status.json"
LOG_FILE = "/var/log/dlmu-campus-login.log"


def now():
    return int(time.time())


def iso(ts=None):
    if not ts:
        ts = now()
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")


def log(message, level="INFO"):
    line = f"{iso()} [{level}] {message}"
    print(line, flush=True)
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def uci_get(option, default=""):
    key = f"{CONFIG}.main.{option}"
    try:
        out = subprocess.check_output(["uci", "-q", "get", key], text=True).strip()
        return out if out != "" else default
    except Exception:
        return default


def as_int(value, default):
    try:
        return int(value)
    except Exception:
        return default


def load_config():
    auth_base = uci_get("auth_base", "https://id.dlmu.edu.cn").rstrip("/")
    return {
        "enabled": uci_get("enabled", "0") == "1",
        "username": uci_get("username", ""),
        "password": uci_get("password", ""),
        "test_url": uci_get("test_url", "http://www.baidu.com"),
        "portal_url": uci_get("portal_url", "http://portal.dlmu.edu.cn/"),
        "auth_base": auth_base,
        "login_url": auth_base + "/login",
        "online_interval": max(5, as_int(uci_get("online_interval", "30"), 30)),
        "fast_interval": max(1, as_int(uci_get("fast_interval", "3"), 3)),
        "failure_threshold": max(1, as_int(uci_get("failure_threshold", "2"), 2)),
        "max_login_retries": max(1, as_int(uci_get("max_login_retries", "3"), 3)),
        "login_cooldown": max(10, as_int(uci_get("login_cooldown", "60"), 60)),
        "portal_info_interval": max(10, as_int(uci_get("portal_info_interval", "60"), 60)),
        "startup_delay": max(0, as_int(uci_get("startup_delay", "10"), 10)),
        "timeout": max(2, as_int(uci_get("timeout", "5"), 5)),
        "verify_tls": uci_get("verify_tls", "0") == "1",
    }


def save_status(**updates):
    os.makedirs(STATUS_DIR, exist_ok=True)
    status = read_status()
    status.update(updates)
    status["updated_at"] = now()
    status["updated_at_text"] = iso(status["updated_at"])
    tmp = STATUS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(status, fh, ensure_ascii=False, indent=2, sort_keys=True)
    os.replace(tmp, STATUS_FILE)


def read_status():
    try:
        with open(STATUS_FILE, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return {}


def fmt_duration(seconds):
    seconds = max(0, int(seconds or 0))
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if days:
        return f"{days}d {hours}h {minutes}m"
    if hours:
        return f"{hours}h {minutes}m {seconds}s"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


def new_session():
    session = requests.Session()
    session.trust_env = False
    session.headers.update({
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept-Encoding": "identity",
    })
    return session


def format_bytes(value):
    try:
        num = float(value)
    except Exception:
        return str(value or "")
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    idx = 0
    while num >= 1024 and idx < len(units) - 1:
        num /= 1024
        idx += 1
    if idx == 0:
        return f"{int(num)} {units[idx]}"
    return f"{num:.2f} {units[idx]}"


def check_network(session, cfg):
    try:
        resp = session.get(
            cfg["test_url"],
            timeout=cfg["timeout"],
            allow_redirects=True,
            verify=cfg["verify_tls"],
        )
        return resp.status_code == 200
    except Exception:
        return False


def extract_redirect(text):
    patterns = [
        r"location\.href\s*=\s*['\"]([^'\"]+)['\"]",
        r"window\.location\s*=\s*['\"]([^'\"]+)['\"]",
        r"window\.location\.href\s*=\s*['\"]([^'\"]+)['\"]",
        r"href=[\'\"\u2018]([^\'\"\u2019]+)[\'\"\u2019]</script>",
    ]
    for pattern in patterns:
        match = re.search(pattern, text, re.I)
        if match:
            return match.group(1)
    return None


def aes_encrypt(password, key_b64):
    key = base64.b64decode(key_b64)
    cipher = AES.new(key, AES.MODE_ECB)
    encrypted = cipher.encrypt(pad(password.encode("utf-8"), AES.block_size))
    return base64.b64encode(encrypted).decode("utf-8")


def get_login_params(session, cfg):
    resp = session.get(
        cfg["test_url"],
        timeout=cfg["timeout"],
        verify=cfg["verify_tls"],
        allow_redirects=True,
    )
    auth_url = resp.url
    redirect = extract_redirect(resp.text)
    if redirect:
        auth_url = urljoin(resp.url, redirect)
        resp = session.get(auth_url, timeout=cfg["timeout"], verify=cfg["verify_tls"])

    key_match = re.search(r'"login-croypto">(.*?)<', resp.text)
    exec_match = re.search(r'"login-page-flowkey">(.*?)<', resp.text)
    if not key_match or not exec_match:
        raise RuntimeError("cannot extract login-croypto/login-page-flowkey")
    return auth_url, key_match.group(1), exec_match.group(1)


def do_login(session, cfg):
    if not cfg["username"] or not cfg["password"]:
        raise RuntimeError("username or password is empty")

    auth_url, key_b64, execution = get_login_params(session, cfg)
    encrypted_pwd = aes_encrypt(cfg["password"], key_b64)
    data = {
        "username": cfg["username"],
        "type": "UsernamePassword",
        "_eventId": "submit",
        "geolocation": "",
        "execution": execution,
        "captcha_code": "",
        "croypto": key_b64,
        "password": encrypted_pwd,
    }
    resp = session.post(cfg["login_url"], data=data, allow_redirects=False, timeout=cfg["timeout"])
    if resp.status_code not in (302, 303) or "Location" not in resp.headers:
        raise RuntimeError(f"login failed, http status {resp.status_code}")

    redirect_url = urljoin(auth_url, resp.headers["Location"])
    session.cookies.clear()
    resp2 = session.get(redirect_url, timeout=cfg["timeout"], verify=cfg["verify_tls"])
    if resp2.status_code != 200:
        raise RuntimeError(f"gateway redirect failed, http status {resp2.status_code}")
    return redirect_url


def extract_user_index(url):
    try:
        query = parse_qs(urlparse(url).query)
        values = query.get("userIndex") or []
        return values[0] if values else ""
    except Exception:
        return ""


def parse_ball_info(raw_ball_info):
    result = {}
    if not raw_ball_info:
        return result
    try:
        items = json.loads(raw_ball_info)
    except Exception:
        return result
    for item in items:
        item_id = item.get("id")
        if item_id == "flow":
            raw = item.get("valueOnMoveIn") or item.get("value") or ""
            result["campus_used_flow_raw"] = raw
            result["campus_used_flow"] = format_bytes(raw)
        elif item_id == "packageandfee":
            result["campus_account_fee"] = item.get("value") or ""
    return result


def fetch_portal_info(session, cfg):
    resp = session.get(
        cfg["portal_url"],
        allow_redirects=True,
        timeout=cfg["timeout"],
        verify=cfg["verify_tls"],
    )
    user_index = extract_user_index(resp.url)
    if not user_index:
        raise RuntimeError("未从 portal 页面获取到 userIndex")

    info_url = urljoin(cfg["portal_url"], "/eportal/InterFace.do?method=getOnlineUserInfo")
    headers = {
        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
        "Referer": resp.url,
    }
    info_resp = session.post(
        info_url,
        data={"userIndex": user_index},
        headers=headers,
        timeout=cfg["timeout"],
    )
    text = info_resp.content.decode("utf-8", errors="replace")
    data = json.loads(text)
    if data.get("result") not in ("success", "wait"):
        raise RuntimeError(data.get("message") or "portal 在线信息接口返回失败")

    info = {
        "campus_user_index": user_index,
        "campus_result": data.get("result", ""),
        "campus_message": data.get("message", ""),
        "campus_user_id": data.get("userId", ""),
        "campus_user_name": data.get("userName", ""),
        "campus_user_ip": data.get("userIp", ""),
        "campus_user_mac": data.get("userMac", ""),
        "campus_user_group": data.get("userGroup", ""),
        "campus_account_fee": data.get("accountFee", ""),
        "campus_package": data.get("userPackage", ""),
        "campus_max_leaving_time": data.get("maxLeavingTime", ""),
        "campus_max_flow": data.get("maxFlow", ""),
        "campus_info_at": now(),
        "campus_info_at_text": iso(),
    }
    info.update(parse_ball_info(data.get("ballInfo")))
    return info


def check_campus_online(session, cfg, force_info=False):
    try:
        info = fetch_portal_info(session, cfg)
        save_status(**info, portal_info_error="")
        return True
    except Exception as exc:
        if force_info:
            save_status(portal_info_error=str(exc), portal_info_error_at=now(),
                        portal_info_error_at_text=iso())
        return False


def update_portal_info(session, cfg, force=False):
    status = read_status()
    last = int(status.get("campus_info_at") or 0)
    if not force and now() - last < cfg["portal_info_interval"]:
        return
    try:
        info = fetch_portal_info(session, cfg)
        save_status(**info, portal_info_error="")
    except Exception as exc:
        save_status(portal_info_error=str(exc), portal_info_error_at=now(),
                    portal_info_error_at_text=iso())
        log(f"获取校园网在线信息失败：{exc}", "WARN")


def portal_logout():
    cfg = load_config()
    session = new_session()
    try:
        info = fetch_portal_info(session, cfg)
        user_index = info.get("campus_user_index")
        if not user_index:
            raise RuntimeError("没有可用的 userIndex")
        logout_url = urljoin(cfg["portal_url"], "/eportal/InterFace.do?method=logout")
        resp = session.post(
            logout_url,
            data={"userIndex": user_index},
            headers={"Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"},
            timeout=cfg["timeout"],
        )
        data = json.loads(resp.content.decode("utf-8", errors="replace"))
        if data.get("result") != "success":
            raise RuntimeError(data.get("message") or "portal 下线失败")
        ts = now()
        save_status(
            online=False,
            last_logout_at=ts,
            last_logout_at_text=iso(ts),
            message="已通过 Portal 下线",
            last_error="",
        )
        log("已通过 Portal 下线")
        return 0
    except Exception as exc:
        save_status(last_error=str(exc), last_error_at=now(),
                    last_error_at_text=iso(), message="Portal 下线失败")
        log(f"Portal 下线失败：{exc}", "ERROR")
        return 1


def once():
    cfg = load_config()
    session = new_session()
    save_status(running=True, pid=os.getpid(), last_manual_login_at=now(), last_manual_login_at_text=iso())
    try:
        log("手动检测：检查校园网 Portal 状态")
        if check_campus_online(session, cfg, force_info=True):
            status = read_status()
            online_since = status.get("online_since") or now()
            save_status(online=True, online_since=online_since, online_since_text=iso(online_since),
                        last_error="", last_check_at=now(), last_check_at_text=iso(),
                        message="网络已经在线")
            log("网络已经在线，无需登录")
            return 0
        save_status(online=False, last_login_attempt_at=now(), last_login_attempt_at_text=iso(),
                    message="手动登录开始")
        redirect_url = do_login(session, cfg)
        time.sleep(3)
        if check_campus_online(session, cfg, force_info=True):
            ts = now()
            save_status(online=True, online_since=ts, online_since_text=iso(ts),
                        last_success_at=ts, last_success_at_text=iso(ts),
                        last_error="", message=f"登录成功：{redirect_url}")
            log(f"登录成功：{redirect_url}")
            return 0
        raise RuntimeError("登录流程完成，但网络检测仍失败")
    except Exception as exc:
        save_status(online=False, last_error=str(exc), last_error_at=now(),
                    last_error_at_text=iso(), message="手动登录失败")
        log(f"手动登录失败：{exc}", "ERROR")
        return 1


def daemon():
    cfg = load_config()
    if cfg["startup_delay"]:
        time.sleep(cfg["startup_delay"])

    session = new_session()
    failures = 0
    last_login = 0
    login_retries = 0
    stop = {"value": False}

    def handle_stop(_signum, _frame):
        stop["value"] = True

    signal.signal(signal.SIGTERM, handle_stop)
    signal.signal(signal.SIGINT, handle_stop)

    save_status(running=True, pid=os.getpid(), message="守护进程已启动")
    log("守护进程已启动")

    while not stop["value"]:
        cfg = load_config()
        ts = now()
        online = check_campus_online(session, cfg, force_info=True)
        status = read_status()

        if online:
            if not status.get("online"):
                online_since = ts
                log("检测到校园网在线")
            else:
                online_since = status.get("online_since") or ts
            failures = 0
            login_retries = 0
            save_status(
                running=True,
                pid=os.getpid(),
                online=True,
                online_since=online_since,
                online_since_text=iso(online_since),
                online_duration=fmt_duration(ts - int(online_since)),
                consecutive_failures=0,
                login_retries=0,
                last_check_at=ts,
                last_check_at_text=iso(ts),
                last_error="",
                message="校园网在线",
            )
            sleep_for = cfg["online_interval"]
        else:
            failures += 1
            save_status(
                running=True,
                pid=os.getpid(),
                online=False,
                consecutive_failures=failures,
                last_check_at=ts,
                last_check_at_text=iso(ts),
                message=f"校园网离线，连续检测失败 {failures} 次",
            )
            sleep_for = cfg["fast_interval"]
            cooldown_passed = ts - last_login >= cfg["login_cooldown"]
            can_retry = login_retries < cfg["max_login_retries"] or cooldown_passed
            if failures >= cfg["failure_threshold"] and can_retry:
                if cooldown_passed and login_retries >= cfg["max_login_retries"]:
                    login_retries = 0
                login_retries += 1
                last_login = ts
                save_status(last_login_attempt_at=ts, last_login_attempt_at_text=iso(ts),
                            login_retries=login_retries,
                            max_login_retries=cfg["max_login_retries"],
                            message=f"开始登录（第 {login_retries}/{cfg['max_login_retries']} 次）")
                log(f"检测到离线，开始登录（第 {login_retries}/{cfg['max_login_retries']} 次）")
                try:
                    redirect_url = do_login(session, cfg)
                    time.sleep(3)
                    if check_campus_online(session, cfg, force_info=True):
                        success = now()
                        failures = 0
                        login_retries = 0
                        save_status(
                            online=True,
                            online_since=success,
                            online_since_text=iso(success),
                            online_duration="0s",
                            consecutive_failures=0,
                            login_retries=0,
                            last_success_at=success,
                            last_success_at_text=iso(success),
                            last_error="",
                            message=f"登录成功：{redirect_url}",
                        )
                        log(f"登录成功：{redirect_url}")
                        sleep_for = cfg["online_interval"]
                    else:
                        raise RuntimeError("登录流程完成，但网络检测仍失败")
                except Exception as exc:
                    save_status(last_error=str(exc), last_error_at=now(),
                                last_error_at_text=iso(), login_retries=login_retries,
                                max_login_retries=cfg["max_login_retries"],
                                message=f"登录失败（第 {login_retries}/{cfg['max_login_retries']} 次）")
                    log(f"登录失败（第 {login_retries}/{cfg['max_login_retries']} 次）：{exc}", "ERROR")
                    if login_retries >= cfg["max_login_retries"]:
                        sleep_for = cfg["login_cooldown"]
                    else:
                        sleep_for = cfg["fast_interval"]

        for _ in range(max(1, sleep_for)):
            if stop["value"]:
                break
            time.sleep(1)

    save_status(running=False, message="守护进程已停止")
    log("守护进程已停止")


def status_text():
    st = read_status()
    online_since = st.get("online_since")
    if st.get("online") and online_since:
        st["online_duration"] = fmt_duration(now() - int(online_since))
    keys = [
        ("running", "服务运行"),
        ("online", "校园网在线"),
        ("online_duration", "在线时长"),
        ("online_since_text", "上线时间"),
        ("last_check_at_text", "最近检测"),
        ("last_success_at_text", "最近登录成功"),
        ("last_login_attempt_at_text", "最近登录尝试"),
        ("consecutive_failures", "连续失败"),
        ("last_error", "最近错误"),
        ("portal_info_error", "Portal信息错误"),
        ("campus_user_id", "学号"),
        ("campus_user_name", "姓名"),
        ("campus_user_ip", "校园网IP"),
        ("campus_user_mac", "校园网MAC"),
        ("campus_account_fee", "余额"),
        ("campus_package", "套餐"),
        ("campus_used_flow", "已用流量"),
        ("campus_info_at_text", "Portal信息时间"),
        ("message", "状态消息"),
        ("pid", "PID"),
    ]
    for key, label in keys:
        value = st.get(key, "")
        if value is True:
            value = "是"
        elif value is False:
            value = "否"
        print(f"{label}: {value}")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--daemon", action="store_true")
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--portal-logout", action="store_true")
    parser.add_argument("--status-text", action="store_true")
    args = parser.parse_args()
    if args.status_text:
        status_text()
        return 0
    if args.once:
        return once()
    if args.portal_logout:
        return portal_logout()
    if args.daemon:
        daemon()
        return 0
    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
